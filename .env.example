# Copy this file to .env.local and fill in real values before running the app.

# Credentials for the FIRST admin account (used by scripts/seed.js and the
# fallback login check in lib/auth.js). Change the password after first login
# by editing data/admins.json, or extend lib/auth.js to hash + rotate it.
ADMIN_EMAIL=admin@devsoc.club
ADMIN_PASSWORD=change-this-password

# Random long string used to sign the admin session cookie.
SESSION_SECRET=replace-with-a-long-random-string
